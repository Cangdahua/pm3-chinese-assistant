{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM3 实验原型（禁止发布）",
  "version": "0.1.0",
  "identifier": "com.pm3studio.experimental",
  "build": {
    "beforeDevCommand": "pnpm prototype:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm prototype:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PM3 实验原型 · 禁止发布",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
