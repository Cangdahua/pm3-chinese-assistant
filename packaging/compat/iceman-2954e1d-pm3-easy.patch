@@ -61,7 +62,94 @@ struct receiver_arg {
 };
 
 byte_t rx[sizeof(UsbCommand)];
-byte_t* prx = rx;
+
+#define VENDOR_FRAME_HEADER_SIZE 16
+#define VENDOR_RX_BUFFER_SIZE (sizeof(UsbCommand) * 4)
+
+static byte_t vendor_rx[VENDOR_RX_BUFFER_SIZE];
+static size_t vendor_rx_len = 0;
+
+static uint16_t read_le16(const byte_t *data) {
+	return (uint16_t)data[0] | ((uint16_t)data[1] << 8);
+}
+
+static uint32_t read_le32(const byte_t *data) {
+	return (uint32_t)data[0] |
+		((uint32_t)data[1] << 8) |
+		((uint32_t)data[2] << 16) |
+		((uint32_t)data[3] << 24);
+}
+
+static bool looks_like_vendor_frame(const byte_t *data, size_t len) {
+	if (len < 4) {
+		return false;
+	}
+
+	uint16_t wire_cmd = read_le16(data);
+	uint16_t payload_len = read_le16(data + 2);
+	return (wire_cmd & 0x8000) && payload_len <= USB_CMD_DATA_SIZE;
+}
+
+static void handle_vendor_frame(const byte_t *frame) {
+	uint16_t wire_cmd = read_le16(frame);
+	uint16_t payload_len = read_le16(frame + 2);
+	size_t copy_len = payload_len < USB_CMD_DATA_SIZE ? payload_len : USB_CMD_DATA_SIZE;
+	UsbCommand converted;
+
+	memset(&converted, 0x00, sizeof(converted));
+	converted.cmd = wire_cmd & 0x7fff;
+	converted.arg[0] = read_le32(frame + 4);
+	converted.arg[1] = read_le32(frame + 8);
+	converted.arg[2] = read_le32(frame + 12);
+	memcpy(converted.d.asBytes, frame + VENDOR_FRAME_HEADER_SIZE, copy_len);
+	UsbCommandReceived(&converted);
+}
+
+static void consume_vendor_rx(size_t consumed) {
+	if (consumed >= vendor_rx_len) {
+		vendor_rx_len = 0;
+		return;
+	}
+
+	memmove(vendor_rx, vendor_rx + consumed, vendor_rx_len - consumed);
+	vendor_rx_len -= consumed;
+}
+
+static void process_received_bytes(const byte_t *data, size_t len) {
+	if (len == 0) {
+		return;
+	}
+
+	if (len > VENDOR_RX_BUFFER_SIZE - vendor_rx_len) {
+		vendor_rx_len = 0;
+	}
+
+	memcpy(vendor_rx + vendor_rx_len, data, len);
+	vendor_rx_len += len;
+
+	while (vendor_rx_len > 0) {
+		if (looks_like_vendor_frame(vendor_rx, vendor_rx_len)) {
+			uint16_t payload_len = read_le16(vendor_rx + 2);
+			size_t frame_len = VENDOR_FRAME_HEADER_SIZE + payload_len;
+
+			if (vendor_rx_len < frame_len) {
+				break;
+			}
+
+			handle_vendor_frame(vendor_rx);
+			consume_vendor_rx(frame_len);
+			continue;
+		}
+
+		if (vendor_rx_len >= sizeof(UsbCommand)) {
+			UsbCommandReceived((UsbCommand*)vendor_rx);
+			consume_vendor_rx(sizeof(UsbCommand));
+			continue;
+		}
+
+		break;
+	}
+}
 
